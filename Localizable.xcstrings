    "Reminder pattern is inferred from recent scheduled dose events when possible.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Erinnerungsmuster wird nach Möglichkeit aus den jüngsten geplanten Dosisereignissen abgeleitet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
