          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayoría de los campos se rellenan automáticamente. Confirma el parche, el gel y los demás datos específicos de PK antes de guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plupart des champs peuvent être remplis automatiquement. Vérifiez les détails propres aux patchs, gels et autres paramètres PK avant d’enregistrer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほとんどの項目は自動入力できます。保存前に、パッチ、ジェルなどPK計算に必要な詳細を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
