    "medplan.import.authorization.message": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie aus, welche Medikamente diese App lesen darf. Der Zugriff umfasst auch die zugehörigen Dosisereignisse und kann jederzeit erneut geprüft werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which medications this app may read. Access also includes their dose events and can be reviewed again at any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué medicamentos puede leer esta app. El acceso incluye también sus eventos de dosis y puedes revisarlo de nuevo en cualquier momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les médicaments que cette app peut lire. L’accès inclut aussi leurs événements de prise et peut être revu à tout moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリに読み取りを許可する薬を選択してください。アクセスには服薬イベントも含まれ、後からいつでも見直せます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择允许本应用读取的用药；权限同时包含对应的给药事件，并可随时重新选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇允許本 App 讀取的用藥；權限同時包含對應的給藥事件，並可隨時重新選擇。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱에서 읽을 약물을 선택하세요. 권한에는 해당 약물의 투여 기록도 포함되며 언제든지 다시 검토할 수 있습니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกยาที่อนุญาตให้แอปอ่าน การเข้าถึงนี้รวมถึงเหตุการณ์การใช้ยาและตรวจสอบสิทธิ์ใหม่ได้ทุกเมื่อ"
          }
        }
      }
    },
