    "input.patchMode.package_hint": {
      "comment": "Patch release rate hint shown in dose input",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn auf der Packung eine Freisetzungsrate wie x µg/Tag angegeben ist, verwenden Sie diesen Wert als maßgebliche Angabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the package shows a release rate like x µg/day, use that value as the source of truth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el envase muestra una tasa de liberación como x µg/día, usa ese valor como referencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si l’emballage indique un débit de libération comme x µg/jour, utilisez cette valeur comme référence."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "包装に「x µg/日」のような放出速度が記載されている場合は、その値を優先してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果包装上标有释放速率（如 x µg/day），请优先以该数值为准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果包裝上標有釋放速率（如 x µg/day），請優先以該數值為準。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포장에 x µg/day와 같은 방출률이 표시되어 있으면 해당 값을 기준으로 사용하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากบรรจุภัณฑ์ระบุอัตราการปล่อย เช่น x µg/วัน ให้ใช้ค่านั้นเป็นข้อมูลหลัก"
          }
        }
      }
    },
