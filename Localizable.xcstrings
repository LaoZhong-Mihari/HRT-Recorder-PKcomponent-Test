    "I could not verify whether this is a planned or custom dose.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich konnte nicht überprüfen, ob dies eine geplante oder benutzerdefinierte Dosis ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pude verificar si esta es una dosis planificada o personalizada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je n’ai pas pu vérifier s’il s’agit d’une dose planifiée ou personnalisée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定投与かカスタム投与かを確認できませんでした。"
