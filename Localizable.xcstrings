    "A natural-language dose phrase, interpreted on device and always reviewed before saving.": {
      "comment": "A natural-language dose phrase, interpreted on device and always reviewed before saving.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine natürlichsprachige Dosisangabe, die auf dem Gerät interpretiert und vor dem Speichern immer überprüft wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una frase de dosis en lenguaje natural, interpretada en el dispositivo y siempre revisada antes de guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une phrase de dose en langage naturel, interprétée sur l’appareil et toujours vérifiée avant l’enregistrement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自然な言葉で入力した投薬内容をデバイス上で解釈し、保存前に必ず確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一条自然语言剂量短语，由设备端解析，并始终在保存前核对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一段自然語言劑量語句，由裝置端解析，並一律在儲存前核對。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에서 해석하며 저장 전에 항상 검토하는 자연어 용량 문구입니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความขนาดยาในภาษาธรรมชาติจะถูกตีความบนอุปกรณ์และตรวจสอบทุกครั้งก่อนบันทึก"
          }
        }
      }
    },
    "A non-PK oral medication to record.": {
      "comment": "A non-PK oral medication to record.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein orales Medikament ohne PK-Berechnung, das nur aufgezeichnet wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un medicamento oral sin PK que se va a registrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un médicament oral sans modèle PK, à enregistrer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PK計算に反映せず、経口薬として記録する薬です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一种用于记录的非 PK 口服药物。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一種供記錄的非 PK 口服藥物。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PK 계산에 사용하지 않고 기록만 하는 경구 약물입니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยารับประทานสำหรับบันทึกเท่านั้นและไม่รวมในการคำนวณ PK"
          }
        }
      }
    },
    "A patch release rate cannot be combined with a mass dose.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Freisetzungsrate eines Pflasters kann nicht mit einer Dosisangabe als Masse kombiniert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tasa de liberación del parche no puede combinarse con una dosis por masa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un débit de libération de patch ne peut pas être associé à une dose massique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パッチの放出速度と質量による投与量は同時に指定できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "贴片释放速率不能与质量剂量同时使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼片釋放速率不能與質量劑量同時使用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패치 방출률과 질량 단위 용량을 함께 입력할 수 없습니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถระบุอัตราการปล่อยของแผ่นแปะพร้อมกับขนาดยาตามมวลได้"
          }
        }
      }
    },
    "A patch release rate cannot be combined with other dose details.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Freisetzungsrate eines Pflasters kann nicht mit anderen Dosisangaben kombiniert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tasa de liberación del parche no puede combinarse con otros datos de la dosis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un débit de libération de patch ne peut pas être associé à d’autres détails de dose."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パッチの放出速度は、ほかの投与情報と同時に指定できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "贴片释放速率不能与其他剂量详情同时使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼片釋放速率不能與其他劑量詳情同時使用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패치 방출률과 다른 용량 세부 정보를 함께 입력할 수 없습니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถระบุอัตราการปล่อยของแผ่นแปะพร้อมกับรายละเอียดขนาดยาอื่นได้"
          }
        }
      }
    },
    "A record-only medication cannot be combined with that hormone category.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Medikament, das nur aufgezeichnet wird, kann nicht mit dieser Hormonkategorie kombiniert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un medicamento solo de registro no puede combinarse con esa categoría hormonal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un médicament destiné uniquement à l’enregistrement ne peut pas être associé à cette catégorie d’hormone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録専用薬は、そのホルモン分類と組み合わせられません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅记录药物不能与该激素类别组合。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅記錄藥物不能與該激素類別組合。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 전용 약물은 해당 호르몬 범주와 함께 사용할 수 없습니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถใช้ยาสำหรับบันทึกเท่านั้นร่วมกับหมวดฮอร์โมนนั้นได้"
          }
        }
      }
    },
    "A record-only medication does not use an active-equivalent dose.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Medikament, das nur aufgezeichnet wird, verwendet keine wirkstoffäquivalente Dosis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un medicamento solo de registro no utiliza una dosis equivalente de principio activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un médicament destiné uniquement à l’enregistrement n’utilise pas de dose équivalente en substance active."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録専用薬では有効成分換算投与量を使用しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅记录药物不使用活性成分当量剂量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅記錄藥物不使用活性成分當量劑量。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 전용 약물에는 활성 성분 환산 용량을 사용하지 않습니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยาสำหรับบันทึกเท่านั้นไม่ใช้ขนาดยาสมมูลของสารออกฤทธิ์"
          }
        }
      }
    },
