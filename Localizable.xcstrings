    "Use estradiol dosing and E2 lab values for the active PK curve.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Estradiol-Dosen und E2-Laborwerte für die aktive PK-Kurve verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa las dosis de estradiol y los valores de E2 del laboratorio para la curva de PK activa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser les doses d’estradiol et les valeurs biologiques E2 pour la courbe PK active."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のPK曲線に、エストラジオールの投薬とE2検査値を使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 PK 曲线使用雌二醇给药和 E2 化验值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前 PK 曲線使用雌二醇給藥與 E2 化驗值。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 PK 곡선에 에스트라디올 투여 기록과 E2 검사 수치를 사용합니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ข้อมูลการใช้เอสตราไดออลและผลตรวจ E2 กับเส้นโค้ง PK ที่ใช้งานอยู่"
          }
        }
      }
    },
    "Use testosterone dosing and T lab values for the active PK curve.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Testosteron-Dosen und T-Laborwerte für die aktive PK-Kurve verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa las dosis de testosterona y los valores de T del laboratorio para la curva de PK activa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser les doses de testostérone et les valeurs biologiques T pour la courbe PK active."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のPK曲線に、テストステロンの投薬とT検査値を使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 PK 曲线使用睾酮给药和 T 化验值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前 PK 曲線使用睪酮給藥與 T 化驗值。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 PK 곡선에 테스토스테론 투여 기록과 T 검사 수치를 사용합니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ข้อมูลการใช้เทสโทสเตอโรนและผลตรวจ T กับเส้นโค้ง PK ที่ใช้งานอยู่"
          }
        }
      }
    },
    "Use the current time or a past time for a dose record.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
