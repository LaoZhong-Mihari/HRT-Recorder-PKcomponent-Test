    },
    "That phrase mixes a planned dose with custom dose details. Please choose one before recording.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Angabe kombiniert eine geplante Dosis mit eigenen Dosisdetails. Wählen Sie vor dem Aufzeichnen eine der beiden Optionen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
