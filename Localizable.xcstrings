    "medimport.note.needs_dose_with_schedule": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health hat geplante Erinnerungszeiten bereitgestellt, aber die geplante Dosis konnte nicht vollständig in eine verwendbare Vorlage umgewandelt werden. Bestätigen Sie die Dosisangaben vor dem Speichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health provided scheduled reminder times, but the app couldn't fully convert the scheduled dose into a usable template. Confirm the dose details before saving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salud proporcionó horas de recordatorio, pero la app no pudo convertir por completo la dosis programada en una plantilla utilizable. Confirma los datos de la dosis antes de guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Santé a fourni des heures de rappel, mais l’app n’a pas pu convertir entièrement la dose planifiée en un modèle utilisable. Confirmez les détails de la dose avant l’enregistrement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアから通知時刻を取得しましたが、予定投与量を使用可能なテンプレートへ完全には変換できませんでした。保存前に投薬情報を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Health 提供了计划提醒时间，但应用还无法把计划剂量完整换算成可用模板，保存前请确认剂量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Health 提供了計劃提醒時間，但App還無法把計劃劑量完整換算成可用模板，儲存前請確認劑量。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Health에서 예정 알림 시간을 제공했지만 예정 용량을 사용 가능한 템플릿으로 완전히 변환하지 못했습니다. 저장하기 전에 용량 세부 정보를 확인하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Health ให้เวลาแจ้งเตือนตามกำหนด แต่แอปไม่สามารถแปลงขนาดยาตามกำหนดเป็นแม่แบบที่ใช้ได้อย่างสมบูรณ์ โปรดยืนยันรายละเอียดขนาดยาก่อนบันทึก"
          }
        }
      }
    },
    "medimport.note.needs_dose_without_schedule": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Medikament entspricht einer Regel, aber aus Apple Health konnte keine Standarddosis erstellt werden. Bestätigen Sie die Dosis vor dem Speichern manuell."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This medication matched a rule, but the app couldn't build a default dose from Health. Confirm the dose manually before saving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este medicamento coincide con una regla, pero la app no pudo crear una dosis predeterminada a partir de Salud. Confirma la dosis manualmente antes de guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce médicament correspond à une règle, mais l’app n’a pas pu créer de dose par défaut à partir de Santé. Confirmez manuellement la dose avant l’enregistrement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応ルールと一致しましたが、ヘルスケアから既定の投薬内容を作成できませんでした。保存前に投与量を手動で確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此药物已匹配到规则，但应用还无法从 Health 生成默认剂量，保存前请手动确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此藥物已匹配到規則，但App還無法从 Health 生成預設劑量，儲存前請手動確認。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 약물은 규칙과 일치했지만 Health에서 기본 용량을 만들지 못했습니다. 저장하기 전에 용량을 직접 확인하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยานี้ตรงกับกฎ แต่แอปไม่สามารถสร้างขนาดยาเริ่มต้นจาก Health ได้ โปรดยืนยันขนาดยาด้วยตนเองก่อนบันทึก"
          }
        }
      }
    },
    "medimport.note.needs_rule": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Apple-Health-Medikament gibt es noch keine Zuordnungsregel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No alignment rule yet for this Health medication."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no existe una regla de correspondencia para este medicamento de Salud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune règle de correspondance n’existe encore pour ce médicament de Santé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このヘルスケアの薬に対応するルールはまだありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这条 Health 用药目前还没有对齐规则。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這條 Health 用藥目前還沒有對齊規則。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Health 약물에 대한 연결 규칙이 아직 없습니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีกฎการจับคู่สำหรับยานี้จาก Health"
          }
        }
      }
    },
    "medimport.note.record_only_format": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird nur als orales Medikament für Erinnerungen und Aufzeichnungen importiert und beeinflusst die Estradiol-Simulation nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is imported as an oral reminder/record medication only and won't affect estradiol simulation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se importa solo como medicamento oral para recordatorios y registros, y no afecta a la simulación de estradiol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est importé uniquement comme médicament oral pour les rappels et l’enregistrement, et n’influence pas la simulation de l’estradiol."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は経口のリマインダー／記録専用薬として読み込まれ、エストラジオールのシミュレーションには影響しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会作为仅提醒/记录的口服药物导入，不会影响雌二醇模拟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 會作為僅提醒/記錄的口服藥物匯入，不會影響雌二醇模擬。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@는 경구용 알림/기록 약물로만 가져오며 에스트라디올 시뮬레이션에는 영향을 미치지 않습니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ จะนำเข้าเป็นยารับประทานสำหรับการแจ้งเตือนและบันทึกเท่านั้น โดยไม่ส่งผลต่อการจำลองเอสตราไดออล"
          }
        }
      }
    },
    "medimport.note.sublingual_confirmation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine sublinguale Anwendung wird nicht automatisch erkannt. Bestätigen Sie, ob die Anwendung oral bleiben oder auf sublingual geändert werden soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sublingual dosing isn't auto-detected. Confirm whether this should stay oral or become sublingual."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La administración sublingual no se detecta automáticamente. Confirma si debe seguir siendo oral o cambiarse a sublingual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La prise sublinguale n’est pas détectée automatiquement. Confirmez si elle doit rester orale ou devenir sublinguale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "舌下投与は自動判定されません。経口のままにするか舌下へ変更するか確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用不会自动识别舌下给药，请确认这里应保持口服还是改成舌下。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App不會自動識別舌下給藥，請確認這裡應保持口服還是改成舌下。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설하 투여는 자동으로 감지되지 않습니다. 경구로 유지할지 설하로 변경할지 확인하세요."
          }
        },
        "th": {
