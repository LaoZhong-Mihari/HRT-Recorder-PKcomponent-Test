    "Apple Health took too long to answer. Close the sheet and try again.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health hat nicht rechtzeitig geantwortet. Schließen Sie dieses Fenster und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salud de Apple tardó demasiado en responder. Cierra la hoja e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Santé d’Apple a mis trop de temps à répondre. Fermez cette fenêtre et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアからの応答に時間がかかっています。この画面を閉じて、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health 响应时间过长，请关闭后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health 響應時間過長，請關閉後重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health 응답이 지연되고 있습니다. 이 화면을 닫고 다시 시도하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health ใช้เวลาตอบสนองนานเกินไป โปรดปิดหน้าต่างนี้แล้วลองอีกครั้ง"
          }
        }
      }
    },
    "Apple Intelligence is unavailable. Please use the structured dose fields or review the dose in HRT Recorder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ist nicht verfügbar. Bitte verwenden Sie die strukturierten Dosisfelder oder überprüfen Sie die Dosis in HRT Recorder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence no está disponible. Usa los campos estructurados de la dosis o revísala en HRT Recorder."
