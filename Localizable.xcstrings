    "about.sisters.footer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Projekte verwenden den gleichen E2-Algorithmus und bieten weitere Funktionen direkt auf ihren Websites."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These projects use the same E2 algorithm and offer more features directly on their websites."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos proyectos utilizan el mismo algoritmo E2 y ofrecen más funciones directamente en sus sitios web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces projets utilisent le même algorithme E2 et proposent davantage de fonctions directement sur leurs sites web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのプロジェクトは同じE2アルゴリズムを採用し、各ウェブサイトでさらに多くの機能を提供しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些项目使用同样的 E2 算法，并且可以在对应网站上直接使用，功能也更多。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些專案使用同樣的 E2 算法，並且可以在對應網站上直接使用，功能也更多。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이러한 프로젝트는 동일한 E2 알고리즘을 사용하고 웹사이트에서 직접 더 많은 기능을 제공합니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โครงการเหล่านี้ใช้อัลกอริทึม E2 เดียวกันและมีคุณสมบัติเพิ่มเติมบนเว็บไซต์ของแต่ละโครงการ"
          }
        }
      }
    },
