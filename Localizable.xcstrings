    "Health marks this medication as taken as needed. Add a reminder plan manually if needed.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health kennzeichnet dieses Medikament als bedarfsweise eingenommen. Fügen Sie bei Bedarf manuell einen Erinnerungsplan hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
