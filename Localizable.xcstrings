    "medplan.import.empty.message": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese App sind derzeit keine aktiven Medikamente aus Apple Health verfügbar. Fügen Sie in Health ein Medikament hinzu oder prüfen Sie den Medikamentenzugriff."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No active Apple Health medications are currently available to this app. Add one in Health or review medication access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualmente no hay medicamentos activos de Salud de Apple disponibles para esta app. Añade uno en Salud o revisa el acceso a los medicamentos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun médicament actif de Santé n’est actuellement accessible à cette app. Ajoutez-en un dans Santé ou vérifiez les autorisations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリで利用できる有効なヘルスケアの薬がありません。ヘルスケアに薬を追加するか、アクセス設定を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前没有可供本应用读取的 Apple 健康用药。请在“健康”中添加药物或检查用药访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有可供本 App 讀取的 Apple 健康用藥。請在「健康」中新增藥物或檢查用藥存取權限。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 이 앱에서 사용할 수 있는 활성 Apple Health 약물이 없습니다. Health에서 약물을 추가하거나 접근 권한을 검토하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะนี้แอปยังไม่พบยาที่ใช้งานอยู่จาก Apple Health ให้เพิ่มยาใน Health หรือตรวจสอบสิทธิ์เข้าถึงยา"
          }
        }
      }
    },
