    "%@ is about %@ %@ at %@.": {
      "comment": "A summary of a hormone concentration. The first argument is the hormone name. The second argument is the string “%.1f”. The third argument is the concentration unit. The fourth argument is the date and time of the measurement.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ beträgt um %4$@ ungefähr %2$@ %3$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is about %2$@ %3$@ at %4$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ es aproximadamente %2$@ %3$@ a las %4$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est estimé à %2$@ %3$@ à %4$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は%4$@時点で約%2$@ %3$@です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在 %4$@ 约为 %2$@ %3$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在 %4$@ 約為 %2$@ %3$@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%4$@ 기준 %1$@은(는) 약 %2$@ %3$@입니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ มีค่าประมาณ %2$@ %3$@ ณ %4$@"
          }
        }
      }
    },
