    "input.record_only.help": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antiandrogen-Einträge werden als orale Einträge und Erinnerungspläne gespeichert. Sie beeinflussen die Estradiol-Simulation nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anti-androgen entries are saved as oral records and reminder plans. They do not affect estradiol simulation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los antiandrógenos se guardan como registros orales y planes de recordatorios. No afectan a la simulación de estradiol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les antiandrogènes sont enregistrés comme prises orales et plans de rappels. Ils n’influencent pas la simulation de l’estradiol."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "抗アンドロゲン薬は経口の記録とリマインダープランとして保存され、エストラジオールのシミュレーションには影響しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抗雄药物会按口服记录和提醒计划保存，不会影响雌二醇模拟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "抗雄藥物會按口服記錄和提醒計劃儲存，不會影響雌二醇模擬。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항안드로겐 항목은 경구 기록 및 알림 계획으로 저장되며 에스트라디올 시뮬레이션에는 영향을 주지 않습니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการยาต้านแอนโดรเจนจะบันทึกเป็นยารับประทานและแผนการแจ้งเตือน โดยไม่ส่งผลต่อการจำลองเอสตราไดออล"
          }
        }
      }
    },
