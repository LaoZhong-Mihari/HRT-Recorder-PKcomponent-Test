    "You can change this later in Settings. Existing lab reports are not changed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können dies später in den Einstellungen ändern. Bestehende Laborberichte werden nicht geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiarlo más adelante en Ajustes. Los informes de laboratorio existentes no se modificarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pourrez modifier ce choix plus tard dans Réglages. Les bilans existants ne seront pas modifiés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定は後から変更できます。保存済みの検査レポートは変更されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后可在设置中更改。已有化验报告不会被修改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之後可在設定中更改。已有化驗報告不會被修改。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에 설정에서 변경할 수 있습니다. 기존 검사 보고서는 변경되지 않습니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเปลี่ยนการตั้งค่านี้ภายหลังได้ในการตั้งค่า โดยรายงานผลตรวจที่มีอยู่จะไม่เปลี่ยนแปลง"
          }
        }
      }
    },
