    "medplan.import.header.message": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies liest Medikationsdefinitionen von Apple Health. Es importiert weder die Dosishistorie noch die aufgezeichneten Datensätze."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This reads medication definitions from Apple Health. It does not import dose history or logged records."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta función lee las definiciones de medicamentos de Salud de Apple. No importa el historial de dosis ni los registros guardados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette fonction lit les définitions des médicaments dans Santé. Elle n’importe ni l’historique des prises ni les enregistrements."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアから薬剤情報を読み取ります。投薬履歴や記録済みデータは読み込みません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里只会读取 Apple 健康中的用药定义，不会导入服药历史或已记录条目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡只會讀取 Apple 健康中的用藥定義，不會匯入服藥歷史或已記錄條目。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health에서 약물 정의만 읽습니다. 투여 내역이나 기록은 가져오지 않습니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟังก์ชันนี้อ่านข้อมูลยาจาก Apple Health แต่ไม่นำเข้าประวัติขนาดยาหรือรายการที่บันทึกไว้"
          }
        }
      }
    },
