    "Record-only medications can only be recorded as oral medications.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Medikamente, die nur aufgezeichnet werden, können ausschließlich als orale Medikamente erfasst werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los medicamentos de registro exclusivo solo se pueden registrar como medicamentos orales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les médicaments à enregistrer uniquement ne peuvent être saisis que par voie orale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録専用薬は経口薬としてのみ記録できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅记录药物只能按口服药物记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅記錄藥物只能按口服藥物記錄。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 전용 약물은 경구 약물로만 기록할 수 있습니다."
          }
        },
        "th": {
