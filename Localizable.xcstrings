    "medplan.import.schedule_confirmation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health hat nicht genügend aktuelle Zeitplanereignisse bereitgestellt, um diesen Rhythmus zu bestätigen. Erinnerungen sind zunächst deaktiviert; prüfen Sie vor dem Aktivieren die Uhrzeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health did not provide enough recent schedule events to confirm this cadence. Reminders start off; review the time before enabling them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salud no proporcionó suficientes eventos recientes del horario para confirmar esta frecuencia. Los recordatorios empiezan desactivados; revisa la hora antes de activarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Santé n’a pas fourni assez d’événements récents pour confirmer cette fréquence. Les rappels sont désactivés par défaut ; vérifiez l’heure avant de les activer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアの最近のスケジュールイベントだけでは、この間隔を確認できませんでした。リマインダーはオフで作成されます。有効にする前に時刻を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健康没有提供足够的近期计划事件来确认此频率。提醒默认关闭；请检查时间后再启用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "健康沒有提供足夠的近期計劃事件來確認此頻率。提醒預設關閉；請檢查時間後再啟用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Health의 최근 일정 정보가 부족하여 주기를 확인할 수 없습니다. 알림은 꺼진 상태로 시작되므로 켜기 전에 시간을 검토하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Health มีเหตุการณ์ตามตารางล่าสุดไม่เพียงพอสำหรับยืนยันความถี่นี้ การแจ้งเตือนจะเริ่มต้นเป็นปิด โปรดตรวจสอบเวลาก่อนเปิดใช้"
          }
        }
      }
    },
