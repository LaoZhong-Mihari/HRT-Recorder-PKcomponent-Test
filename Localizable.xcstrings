          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำนวนชั่วโมงก่อนและหลังเวลาปัจจุบันที่เส้นโค้งในวิดเจ็ตจะแสดง"
          }
        }
      }
    },
    "This dose is no longer available. Choose a medication plan again.": {
      "comment": "Error message when a dose option is no longer available.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Dosis ist nicht mehr verfügbar. Wählen Sie erneut einen Medikamentenplan aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta dosis ya no está disponible. Elige de nuevo un plan de medicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette dose n’est plus disponible. Choisissez de nouveau un plan de traitement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この投薬内容は利用できなくなりました。服薬プランをもう一度選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该剂量已不可用。请重新选择用药计划。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該劑量已無法使用。請重新選擇用藥計劃。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 용량은 더 이상 사용할 수 없습니다. 복약 계획을 다시 선택하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขนาดยานี้ไม่พร้อมใช้งานแล้ว โปรดเลือกแผนการใช้ยาอีกครั้ง"
          }
        }
      }
    },
    "This HRT type controls the default dose, PK curve, and lab calibration. Reports still keep both E2 and T results.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser HRT-Typ bestimmt Standarddosis, PK-Kurve und Laborkalibrierung. Berichte speichern weiterhin sowohl E2- als auch T-Ergebnisse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tipo de HRT controla la dosis predeterminada, la curva de PK y la calibración de laboratorio. Los informes siguen conservando los resultados de E2 y T."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce type de THS détermine la dose par défaut, la courbe PK et l’étalonnage biologique. Les bilans conservent toujours les résultats E2 et T."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このHRTタイプが、既定の投薬、PK曲線、検査値の校正対象を決めます。レポートにはE2とTの両方が保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 HRT 类型控制默认给药、PK 曲线和化验校准。报告仍会同时保留 E2 和 T 结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 HRT 類型控制預設給藥、PK 曲線與化驗校準。報告仍會同時保留 E2 與 T 結果。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 HRT 유형은 기본 용량, PK 곡선 및 검사 보정에 사용됩니다. 보고서에는 E2와 T 결과가 모두 저장됩니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประเภท HRT นี้กำหนดขนาดยาเริ่มต้น เส้นโค้ง PK และการปรับเทียบผลตรวจ โดยรายงานจะยังเก็บผลทั้ง E2 และ T"
          }
        }
      }
    },
    "This only removes the reminder schedule. Logged doses stay.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird nur der Erinnerungsplan entfernt. Aufgezeichnete Dosen bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto solo elimina el horario de recordatorios. Las dosis registradas se mantienen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le calendrier des rappels sera supprimé. Les doses enregistrées seront conservées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除されるのはリマインダースケジュールだけです。記録済みの投薬は残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这只会删除提醒计划，已记录的给药会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這只會刪除提醒計劃，已記錄的給藥會保留。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 일정만 제거됩니다. 기록한 용량은 유지됩니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้ลบเฉพาะตารางการแจ้งเตือน รายการใช้ยาที่บันทึกไว้จะยังคงอยู่"
          }
        }
      }
    },
    "This plan is paused.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Plan ist pausiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este plan está pausado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce plan est en pause."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプランは一時停止中です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该计划已暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該計劃已暫停。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계획은 일시 중지되어 있습니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แผนนี้ถูกหยุดชั่วคราว"
          }
        }
      }
    },
    "This removes only the local reminder plan. The medication and dose history in Apple Health stay unchanged.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird nur der lokale Erinnerungsplan entfernt. Medikament und Dosishistorie in Apple Health bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes only the local reminder plan. The medication and dose history in Apple Health stay unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se elimina el plan local de recordatorios. El historial de medicamentos y dosis de Salud de Apple no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le plan de rappel local sera supprimé. Le médicament et l’historique des prises dans Santé d’Apple resteront inchangés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除されるのはローカルのリマインダープランだけです。ヘルスケアの薬剤情報と投薬履歴は変更されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这只会删除本地提醒计划；Apple 健康中的药物和给药历史不会改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這只會刪除本機提醒計劃；Apple 健康中的藥物和給藥記錄不會改變。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 알림 계획만 제거됩니다. Apple Health의 약물 및 투여 내역은 변경되지 않습니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้ลบเฉพาะแผนการแจ้งเตือนในแอป ประวัติยาและการใช้ยาใน Apple Health จะไม่เปลี่ยนแปลง"
          }
        }
      }
    },
    "This report may contain both E2 and T. Only %@ is used to calibrate the current HRT curve; all results remain saved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Bericht kann E2 und T enthalten. Nur %@ wird zur Kalibrierung der aktuellen HRT-Kurve verwendet; alle Ergebnisse bleiben gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This report may contain both E2 and T. Only %@ is used to calibrate the current HRT curve; all results remain saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este informe puede contener E2 y T. Solo %@ se utiliza para calibrar la curva de HRT actual; todos los resultados permanecen guardados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce bilan peut contenir E2 et T. Seul %@ sert à étalonner la courbe THS actuelle ; tous les résultats restent enregistrés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレポートにはE2とTの両方が含まれる場合があります。現在のHRT曲線の校正には%@のみを使用し、すべての結果を保存します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一张报告可以同时包含 E2 和 T；当前仅使用 %@ 校准所选 HRT 曲线，所有结果仍会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一張報告可以同時包含 E2 與 T；目前僅使用 %@ 校準所選 HRT 曲線，所有結果仍會保留。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 보고서에는 E2와 T가 모두 포함될 수 있습니다. 현재 HRT 곡선을 보정하는 데 %@만 사용됩니다. 모든 결과는 저장된 상태로 유지됩니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายงานนี้อาจมีทั้ง E2 และ T ระบบจะใช้เฉพาะ %@ เพื่อปรับเทียบเส้นโค้ง HRT ปัจจุบัน และยังคงบันทึกผลทั้งหมดไว้"
          }
        }
      }
    },
    "Those dose details are incomplete or inconsistent. Please review them before recording.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dosisangaben sind unvollständig oder widersprüchlich. Prüfen Sie sie vor dem Aufzeichnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esos datos de la dosis están incompletos o no son coherentes. Revísalos antes de registrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces détails de dose sont incomplets ou incohérents. Vérifiez-les avant l’enregistrement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投薬情報が不足しているか、内容に矛盾があります。記録前に確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些剂量信息不完整或不一致。请在记录前核对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些劑量資訊不完整或不一致。請在記錄前核對。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "용량 세부 정보가 불완전하거나 서로 일치하지 않습니다. 기록하기 전에 검토하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายละเอียดขนาดยาไม่ครบถ้วนหรือไม่สอดคล้องกัน โปรดตรวจสอบก่อนบันทึก"
          }
        }
      }
    },
    "Those extra dose details do not apply to a gel dose.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese zusätzlichen Dosisangaben gelten nicht für eine Gel-Dosis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esos detalles de dosis adicionales no se aplican a una dosis de gel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces détails supplémentaires ne s’appliquent pas à une dose de gel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加された投薬情報はジェル投与には使用できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些额外剂量详情不适用于凝胶给药。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些額外劑量詳情不適用於凝膠給藥。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 추가 용량 정보는 젤 투여에 적용되지 않습니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายละเอียดขนาดยาเพิ่มเติมเหล่านี้ใช้ไม่ได้กับการทาเจล"
          }
        }
      }
    },
    "Those extra dose details do not apply to a sublingual dose.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese zusätzlichen Dosisangaben gelten nicht für eine sublinguale Dosis."
