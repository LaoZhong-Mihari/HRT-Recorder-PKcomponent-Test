    "medplan.editor.daily_schedule.help": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erinnerungszeiten werden hier festgelegt. Die Medikamentenangaben bestimmen nur Medikament und Dosis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminder times are controlled here. Medication details only control the medication and dose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las horas de los recordatorios se controlan aquí. Los datos de la medicación solo definen el medicamento y la dosis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les heures de rappel sont définies ici. Les détails du médicament définissent uniquement le médicament et la dose."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーの時刻はここで設定します。薬剤の詳細では薬と投与量のみを設定します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里控制的是提醒时间。药物详情只负责药物类型和剂量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡控制的是提醒時間。藥物詳情只負責藥物類型和劑量。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 시간은 여기에서 설정합니다. 약물 세부 정보에서는 약물과 용량만 설정합니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำหนดเวลาแจ้งเตือนได้ที่นี่ ส่วนรายละเอียดยาจะกำหนดเฉพาะยาและขนาดยา"
          }
        }
      }
    },
